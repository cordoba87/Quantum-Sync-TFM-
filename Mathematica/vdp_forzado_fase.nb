Cell["\<\
Sin forzamiento ya se lee el resultado del reto: la coherencia \[Beta] decae \
con \[CapitalGamma]1 = \[Kappa]p(3/2 \[Minus] 3\[Kappa]p/\[Kappa]m) y la \
paridad con el hueco 3\[Kappa]p \[Minus] 2\[Kappa]p\.b2/\[Kappa]m. Con \
forzamiento, el estado estacionario a este orden y la P(\[Theta]) que da: c1 \
y c2 son los arm\[OAcute]nicos de P, que se leen de B1 y B2.\
\>", "Text",ExpressionUUID->"a8ebfc50-4c3a-574e-b59c-ac1d986e3a32"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sol1", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Rest", "[", 
        RowBox[{"Leff", " ", ".", " ", 
         RowBox[{"{", 
          RowBox[{
          "1", ",", " ", "\[CapitalPi]", ",", " ", "\[Beta]", ",", " ", 
           "\[Beta]b"}], "}"}]}], "]"}], " ", "==", " ", "0"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"\[CapitalPi]", ",", " ", "\[Beta]", ",", " ", "\[Beta]b"}], 
       "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x1", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "1", ",", " ", "\[CapitalPi]", ",", " ", "\[Beta]", ",", " ", 
      "\[Beta]b"}], "}"}], " ", "/.", " ", "sol1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"estado", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"x", " ", ".", " ", "rs"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"invLm", "[", 
      RowBox[{"Qp", "[", 
       RowBox[{"V", "[", 
        RowBox[{"x", " ", ".", " ", "rs"}], "]"}], "]"}], "]"}], "/", 
     "\[Kappa]m"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cK", "[", 
    RowBox[{"k_", ",", " ", "poly_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Coefficient", "[", 
       RowBox[{"poly", ",", " ", "z", ",", " ", "m"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", " ", "+", " ", "k"}], ")"}], "!"}], "/", 
        RowBox[{"m", "!"}]}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "0", ",", " ", 
       RowBox[{"Exponent", "[", 
        RowBox[{"poly", ",", " ", "z"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"armonicos", "[", "val_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", " ", "=", " ", 
       RowBox[{
        RowBox[{"estado", "[", 
         RowBox[{"x1", " ", "/.", " ", "val"}], "]"}], " ", "/.", " ", 
        "val"}]}], "}"}], ",", " ", 
     RowBox[{"N", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cK", "[", 
         RowBox[{"1", ",", " ", 
          RowBox[{"s", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{"cK", "[", 
         RowBox[{"2", ",", " ", 
          RowBox[{"s", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], "}"}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pfase1", "[", "val_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"armonicos", "[", "val", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"2", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "\[Theta]"}], "]"}]}], "]"}]}], " ", "+",
         " ", 
        RowBox[{"2", " ", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"c", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "2"}], " ", "I", " ", "\[Theta]"}], "]"}]}], 
          "]"}]}]}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "Pi"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"val20", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Kappa]p", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"\[Kappa]m", " ", "->", " ", "20"}], ",", " ", 
     RowBox[{"\[CapitalDelta]", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"\[ScriptCapitalE]", " ", "->", " ", "1"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"armonicos", "[", "val20", "]"}]}], "Input",ExpressionUUID->\
"7b8b0735-3b49-ab4b-bf98-beb83eb180e0"],

Cell["\<\
La gr\[AAcute]fica de comparaci\[OAcute]n de vdp_forzado.nb, con dos curvas m\
\[AAcute]s. Con \[Kappa]m = 20\[Kappa]p, \[CapitalDelta] = 0 y \
\[ScriptCapitalE] = \[Kappa]p: el l\[IAcute]mite cu\[AAcute]ntico y la \
correcci\[OAcute]n 1/\[Kappa]m, las dos sacadas en fase, frente al modelo de \
tres niveles (la curva de vdp_forzado.nb) y a Fock con 10 niveles, que es el \
resultado exacto:\
\>", "Text",ExpressionUUID->"8c53c669-0d85-fa44-bd7d-5948556569e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]exacto", " ", "=", " ", 
   RowBox[{"estadoEstacionario", "[", 
    RowBox[{
     RowBox[{"N", "[", 
      RowBox[{"liouvilliano", "[", 
       RowBox[{
        RowBox[{"H", " ", "/.", " ", "val20"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"20", ",", " ", 
            RowBox[{"-", "2"}]}], "}"}]}], "}"}], ",", " ", "10"}], "]"}], 
      "]"}], ",", " ", "10"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Pfase", " ", "/.", " ", "val20"}], ",", " ", 
     RowBox[{"Pfase1", "[", "val20", "]"}], ",", " ", 
     RowBox[{"distribucionFase", "[", 
      RowBox[{"\[Rho]3", " ", "/.", " ", "val20"}], "]"}], ",", " ", 
     RowBox[{"distribucionFase", "[", "\[Rho]exacto", "]"}]}], "}"}], ",", 
   " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(\[Theta])\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"PlotStyle", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Automatic", ",", " ", "Automatic", ",", " ", "Dashed", ",", " ", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", " ", "Dotted", ",", " ", "Thick"}], "]"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Kappa]m \[RightArrow] \[Infinity] (fase)\>\"", ",", 
      " ", "\"\<\[Kappa]m = 20 \[Kappa]p, orden 1/\[Kappa]m (fase)\>\"", ",", 
      " ", "\"\<\[Kappa]m = 20 \[Kappa]p, 3 niveles (Fock)\>\"", ",", 
      " ", "\"\<\[Kappa]m = 20 \[Kappa]p, exacto (Fock, 10 niveles)\>\""}], 
     "}"}]}]}], "]"}]}], "Input",ExpressionUUID->"aea3cb2b-525b-0b46-b5cb-\
1d07039b06e2"],

Cell["\<\
\[DownQuestion]Es correcta la correcci\[OAcute]n? Si lo es, el error del l\
\[IAcute]mite cu\[AAcute]ntico tiene que bajar como 1/\[Kappa]m y el de la \
correcci\[OAcute]n como 1/\[Kappa]m\.b2: las columnas \
\[Kappa]m\[CenterDot]error y \[Kappa]m\.b2\[CenterDot]error tienden a una \
constante. Se compara c1 (el primer arm\[OAcute]nico de P) con Fock exacto, \
con \[CapitalDelta] = \[ScriptCapitalE] = \[Kappa]p. La \[UAcute]ltima \
columna es el modelo de tres niveles: su error tambi\[EAcute]n baja solo como \
1/\[Kappa]m, porque le falta el nivel |3\[RightAngleBracket], que ya entra a \
ese orden. La correcci\[OAcute]n en fase no elige niveles y es exacta a orden \
1/\[Kappa]m:\
\>", "Text",ExpressionUUID->"54deab8f-4fbc-1b4b-bd01-1edf5b148fb6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"errores", "[", "kmv_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"val", " ", "=", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Kappa]p", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\[Kappa]m", " ", "->", " ", "kmv"}], ",", " ", 
          RowBox[{"\[CapitalDelta]", " ", "->", " ", "1"}], ",", " ", 
          RowBox[{"\[ScriptCapitalE]", " ", "->", " ", "1"}]}], "}"}]}], ",", 
       " ", "\[Rho]F", ",", " ", "c1F", ",", " ", "c1lim", ",", " ", "c1fase",
        ",", " ", "c13"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"\[Rho]F", " ", "=", " ", 
       RowBox[{"estadoEstacionario", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"liouvilliano", "[", 
           RowBox[{
            RowBox[{"H", " ", "/.", " ", "val"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"kmv", ",", " ", 
                RowBox[{"-", "2"}]}], "}"}]}], "}"}], ",", " ", "10"}], "]"}],
           "]"}], ",", " ", "10"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"c1F", " ", "=", " ", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"\[Rho]F", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"m", " ", "+", " ", "2"}], ",", " ", 
            RowBox[{"m", " ", "+", " ", "1"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"m", ",", " ", "0", ",", " ", "8"}], "}"}]}], "]"}]}], ";", 
      "\n", "   ", 
      RowBox[{"c1lim", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"\[Beta]", " ", "/.", " ", "sol0"}], " ", "/.", " ", "val"}],
         "]"}]}], ";", " ", 
      RowBox[{"c1fase", " ", "=", " ", 
       RowBox[{
        RowBox[{"armonicos", "[", "val", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"c13", " ", "=", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Rho]3", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
           RowBox[{"\[Rho]3", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", " ", "2"}], "]"}], "]"}]}], ")"}], " ", "/.", 
         " ", "val"}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"kmv", ",", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"c1lim", " ", "-", " ", "c1F"}], "]"}], ",", " ", 
        RowBox[{"kmv", " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"c1lim", " ", "-", " ", "c1F"}], "]"}]}], ",", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"c1fase", " ", "-", " ", "c1F"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"kmv", "^", "2"}], " ", 
         RowBox[{"Abs", "[", 
          RowBox[{"c1fase", " ", "-", " ", "c1F"}], "]"}]}], ",", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"c13", " ", "-", " ", "c1F"}], "]"}]}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"errores", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{
     "20", ",", " ", "50", ",", " ", "100", ",", " ", "200", ",", " ", 
      "400"}], "}"}]}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Kappa]m\>\"", ",", " ", "\"\<error l\[IAcute]mite\>\"", 
        ",", " ", "\"\<\[Kappa]m\[CenterDot]error\>\"", ",", 
        " ", "\"\<error 1/\[Kappa]m (fase)\>\"", ",", 
        " ", "\"\<\[Kappa]m\.b2\[CenterDot]error\>\"", ",", 
        " ", "\"\<error 3 niveles\>\""}], "}"}]}], "}"}]}]}], "]"}]}], "Input",\
ExpressionUUID->"a8ec169d-4dde-1a4c-954c-6bd8b29bfada"],

Cell["6. Lengua de Arnold", "Section",ExpressionUUID->"f8daac57-5582-2b4b-93e1-376ff228ecfe"],

Cell["\<\
En el l\[IAcute]mite cu\[AAcute]ntico P(\[Theta]) = [1 + 2|\[Beta]| cos(\
\[Theta] \[Minus] arg \[Beta])]/2\[Pi], as\[IAcute] que |\[Beta]| = \
|\[Rho]10| mide cu\[AAcute]nto se engancha el oscilador al forzamiento. Sale \
anal\[IAcute]tico de la secci\[OAcute]n 2. El mismo mapa que en \
vdp_forzado.nb:\
\>", "Text",ExpressionUUID->"03e652de-36e7-f446-bb58-b604cd3c14ed"],

