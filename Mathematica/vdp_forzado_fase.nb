Cell[BoxData[{
 RowBox[{
  RowBox[{"L2", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ell", "[", 
