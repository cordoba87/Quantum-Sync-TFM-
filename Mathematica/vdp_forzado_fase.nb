                 RowBox[{
                  RowBox[{"Lmenos", "[", "k", "]"}], "[", "f", "]"}], " ", "-",
                  " ", "g"}], "]"}], ",", " ", "z"}], "]"}], " ", "==", " ", 
             "0"}], "]"}], ",", " ", "cons"}], "]"}], ",", " ", "cs"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"Expand", "[", 
       RowBox[{"f", " ", "/.", " ", 
        RowBox[{"First", "[", "sol", "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"invLm", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
