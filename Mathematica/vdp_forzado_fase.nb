 RowBox[{
  RowBox[{
   RowBox[{"lentosK", "[", 
    RowBox[{"nK_", ",", " ", "M_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
