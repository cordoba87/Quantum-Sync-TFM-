          RowBox[{
           RowBox[{"(", 
            RowBox[{"u0", " ", "+", " ", "u1"}], ")"}], "/", "2"}]}]}], "]"}],
        ",", " ", 
       RowBox[{"ReplacePart", "[", 
        RowBox[{"c", ",", " ", 
         RowBox[{"1", " ", "->", " ", 
