     RowBox[{"{", 
      RowBox[{"\"\<\[CapitalDelta]/\[Kappa]p\>\"", ",", 
       " ", "\"\<\[ScriptCapitalE]/\[Kappa]p\>\""}], "}"}]}], ",", " ", 
    RowBox[{"PlotLabel", " ", "->", " ", "\"\<|\[Rho]10|\>\""}]}], 
   "]"}]}]], "Input",ExpressionUUID->"33a2daf2-cc1b-1344-aefa-4cdb08b30d46"],

Cell["\<\
El tutor pregunta si se puede derivar la aparici\[OAcute]n de la lengua con \
el formalismo de fase (comentario 3 del 2026-10-22). En el l\[IAcute]mite cu\
\[AAcute]ntico no hay frontera n\[IAcute]tida, porque no hay bifurcaci\
\[OAcute]n: la lengua es la cresta de |\[Beta]| en el plano (\[CapitalDelta], \
\[ScriptCapitalE]).\
\>", "Text",ExpressionUUID->"23704658-d5fb-ab4b-949f-c47b06784be8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"TODO", 
      RowBox[{"(", "human", ")"}]}], ":", " ", 
     RowBox[{
     "la", " ", "cresta", " ", "de", " ", "la", " ", "lengua", " ", "de", " ",
       "Arnold", " ", 
