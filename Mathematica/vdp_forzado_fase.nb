Cell["\<\
Con \[Kappa]m = 20\[Kappa]p (r = 1/20) y \[ScriptCapitalE] = \[Kappa]p. Sumas \
parciales de la serie hasta r^J, frente a la banda num\[EAcute]rica de \
vdp_corte_k.nb (con d = 18) y a Fock exacto. Columnas: G(\[Minus]1) (la \
paridad), \:27e8a\:27e9 = B1(1), \[Rho]10 = b0 y R = |\:27e8\[CapitalEHat]\
\:27e9|.\
\>", "Text",ExpressionUUID->"71aaa4c4-2206-ac4c-892a-727f242cb4d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"tablaK", "[", 
