           RowBox[{"-", 
            RowBox[{"(", 
             RowBox[{"n", " ", "+", " ", 
              RowBox[{"k", "/", "2"}], " ", "+", " ", "1"}], ")"}]}]}]}], 
         "}"}], ",", " ", 
