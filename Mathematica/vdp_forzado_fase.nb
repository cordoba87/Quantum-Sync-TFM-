               RowBox[{"n", " ", "+", " ", "1"}]}], "}"}], " ", "->", " ", 
             RowBox[{"(", 
              RowBox[{"n", " ", "+", " ", "k", " ", "+", " ", "1"}], ")"}]}], 
            ",", " ", "Nothing"}], "]"}], ",", "\n", "      ", 
