   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ser", " ", "=", " ", 
        RowBox[{"serieK", "[", 
         RowBox[{"nK", ",", " ", "del", ",", " ", "1", ",", " ", "12"}], 
         "]"}]}], ",", " ", "banda", ",", " ", "fock"}], "}"}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"banda", " ", "=", " ", 
       RowBox[{"lectRhoK", "[", 
        RowBox[{"estBandaK", "[", 
         RowBox[{"18", ",", " ", "nK", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.", ",", " ", "20.", ",", " ", 
            RowBox[{"N", "[", "del", "]"}], ",", " ", "1."}], "}"}]}], "]"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"fock", " ", "=", " ", 
       RowBox[{"lectRhoK", "[", 
        RowBox[{"estBandaK", "[", 
         RowBox[{"18", ",", " ", "17", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1.", ",", " ", "20.", ",", " ", 
            RowBox[{"N", "[", "del", "]"}], ",", " ", "1."}], "}"}]}], "]"}], 
        "]"}]}], ";", "\n", "   ", 
      RowBox[{"TableForm", "[", 
       RowBox[{
        RowBox[{"Join", "[", "\n", "     ", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{
                RowBox[{"N", "@", 
                 RowBox[{"lecturasK", "[", 
                  RowBox[{"sumaK", "[", 
                   RowBox[{"ser", ",", " ", 
                    RowBox[{"1", "/", "20"}], ",", " ", "J"}], "]"}], "]"}]}],
                 ",", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "14"}]}]}], "]"}], ",", " ", 
              RowBox[{"Row", "[", 
               RowBox[{"{", 
                RowBox[{"\"\<serie hasta r^\>\"", ",", " ", "J"}], "}"}], 
               "]"}]}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"J", ",", " ", 
              RowBox[{"{", 
               RowBox[{
               "0", ",", " ", "1", ",", " ", "2", ",", " ", "4", ",", " ", 
                "8", ",", " ", "12"}], "}"}]}], "}"}]}], "]"}], ",", "\n", 
          "     ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{"banda", ",", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "14"}]}]}], "]"}], ",", 
              " ", "\"\<banda numerica (d = 18)\>\""}], "]"}], ",", " ", 
            RowBox[{"Prepend", "[", 
             RowBox[{
              RowBox[{"Chop", "[", 
               RowBox[{"fock", ",", " ", 
                RowBox[{"10", "^", 
                 RowBox[{"-", "14"}]}]}], "]"}], ",", 
              " ", "\"\<Fock exacto\>\""}], "]"}]}], "}"}]}], "]"}], ",", 
        "\n", "    ", 
        RowBox[{"TableHeadings", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"None", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<\>\"", ",", " ", "\"\<G(-1)\>\"", ",", 
             " ", "\"\<<a>\>\"", ",", " ", "\"\<\[Rho]10\>\"", ",", 
             " ", "\"\<R\>\""}], "}"}]}], "}"}]}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Style", "[", 
      RowBox[{"\"\<K = 1, \[CapitalDelta] = 0\>\"", ",", " ", "Bold"}], "]"}],
      ",", " ", 
     RowBox[{"tablaK", "[", 
      RowBox[{"1", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<K = 1, \[CapitalDelta] = \[Kappa]p\>\"", ",", " ", 
       "Bold"}], "]"}], ",", " ", 
     RowBox[{"tablaK", "[", 
      RowBox[{"1", ",", " ", "1"}], "]"}], ",", "\n", "  ", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<K = 2, \[CapitalDelta] = 0\>\"", ",", " ", "Bold"}], "]"}],
      ",", " ", 
     RowBox[{"tablaK", "[", 
      RowBox[{"2", ",", " ", "0"}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", "1.5"}]}], "]"}]}], "Input",ExpressionUUID->"8194a0ba-8a91-fb48-ab13-42a866ae7755"],

Cell["\<\
La serie converge a la banda: con K = 1 y \[CapitalDelta] = 0, \[Rho]10 = \
\[Minus]0,11141423819459 i en los dos casos (coinciden en 14 cifras), y las \
dem\[AAcute]s columnas hasta 10\:207b\.b9\:2070, que es la precisi\[OAcute]n \
de la banda num\[EAcute]rica. Con K = 2 converge a la banda K = 2, que ya est\
\[AAcute] a 10\:207b\:2076 de Fock exacto. El orden 0 es Bloch (\[Rho]10 = \
\[Minus]i/11, un 18 % por debajo); el orden r se pasa un 2,4 %, el orden \
r\.b2 est\[AAcute] a un 0,2 % y el orden r\:2074 a 10\:207b\:2076.\
\>", "Text",ExpressionUUID->"f9ef20d4-6e35-ef47-9752-103cb86a4b0c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
7.3 El orden r en forma cerrada: de d\[OAcute]nde sale el error del corte\
\>", "Subsection",ExpressionUUID->"569ab42e-6ebc-3147-9433-c3053a32cdcc"],

Cell["\<\
Con \[CapitalDelta] y \[ScriptCapitalE] simb\[OAcute]licos. A orden r el \
sector 3 todav\[IAcute]a no entra, as\[IAcute] que K = 2 coincide con la \
jerarqu\[IAcute]a entera y la diferencia entre K = 2 y K = 1 es el error del \
corte K = 1 a primer orden:\
\>", "Text",ExpressionUUID->"7803274f-fb56-f142-8c79-7e514e892d4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"s1", " ", "=", " ", 
   RowBox[{"serieK", "[", 
    RowBox[{
    "1", ",", " ", "\[CapitalDelta]", ",", " ", "\[ScriptCapitalE]", ",", " ",
      "1"}], "]"}]}], ";", " ", 
  RowBox[{"s2", " ", "=", " ", 
   RowBox[{"serieK", "[", 
    RowBox[{
    "2", ",", " ", "\[CapitalDelta]", ",", " ", "\[ScriptCapitalE]", ",", " ",
      "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ordenRho", "[", 
    RowBox[{"ser_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Factor", "[", 
    RowBox[{"Simplify", "[", 
     RowBox[{"ser", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "2", ",", " ", "1"}], 
       "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Column", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\"\<orden 0:\>\"", " ", "->", " ", 
     RowBox[{"ordenRho", "[", 
      RowBox[{"s1", ",", " ", "0"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<orden r, K = 1:\>\"", " ", "->", " ", 
     RowBox[{"ordenRho", "[", 
      RowBox[{"s1", ",", " ", "1"}], "]"}]}], ",", " ", 
    RowBox[{"\"\<orden r, K = 2 (exacto a este orden):\>\"", " ", "->", " ", 
     RowBox[{"ordenRho", "[", 
      RowBox[{"s2", ",", " ", "1"}], "]"}]}]}], "}"}], "]"}]}], "Input",Expres\
sionUUID->"b874f495-b1c8-5644-910d-9a55cc59765f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\"\<error de \[Rho]10 del corte K = 1, a orden r:\>\"", " ", "->",
     " ", 
    RowBox[{"Factor", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{"ordenRho", "[", 
        RowBox[{"s2", ",", " ", "1"}], "]"}], " ", "-", " ", 
       RowBox[{"ordenRho", "[", 
        RowBox[{"s1", ",", " ", "1"}], "]"}]}], "]"}], "]"}]}], ",", "\n", 
   " ", 
   RowBox[{"\"\<error de la paridad G(-1), a orden r:\>\"", " ", "->", " ", 
    RowBox[{"Factor", "[", 
     RowBox[{"Simplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ev", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "5"}], "]"}], " ", ".", " ", 
        RowBox[{"s2", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], " ", "-", " ", 
       RowBox[{
        RowBox[{"ev", "[", 
         RowBox[{
          RowBox[{"-", "1"}], ",", " ", "5"}], "]"}], " ", ".", " ", 
        RowBox[{"s1", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}]}], "]"}], "]"}]}]}], 
  "}"}]], "Input",ExpressionUUID->"6df2ee27-2ddd-7b45-9deb-1557d08ad910"],

Cell["\<\
El error de \[Rho]10 va como r \[ScriptCapitalE]\.b3 y el de la paridad como \
r \[ScriptCapitalE]\:2074. Como \[Rho]10 \[Proportional] \[ScriptCapitalE], \
el error relativo va como r \[ScriptCapitalE]\.b2: es la ley que \
sali\[OAcute] num\[EAcute]ricamente en vdp_corte_k.nb (secci\[OAcute]n 6.6), \
ahora deducida. El sector 3 no cambia nada ni a orden r ni a orden r\.b2:\
\>", "Text",ExpressionUUID->"480d1d15-13b3-7844-9d94-0a48fe0d0179"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t2", " ", "=", " ", 
      RowBox[{"serieK", "[", 
       RowBox[{
       "2", ",", " ", "\[CapitalDelta]", ",", " ", "\[ScriptCapitalE]", ",", 
        " ", "2"}], "]"}]}], ",", " ", 
     RowBox[{"t3", " ", "=", " ", 
      RowBox[{"serieK", "[", 
       RowBox[{
       "3", ",", " ", "\[CapitalDelta]", ",", " ", "\[ScriptCapitalE]", ",", 
        " ", "2"}], "]"}]}]}], "}"}], ",", "\n", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"t3", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}], " ", "-", 
       " ", 
       RowBox[{"t2", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}]}], ",", 
      " ", 
      RowBox[{
       RowBox[{"t3", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}], " ", "-", 
       " ", 
       RowBox[{"t2", "[", 
        RowBox[{"[", 
         RowBox[{"3", ",", " ", "2", ",", " ", "1"}], "]"}], "]"}]}]}], "}"}],
     "]"}]}], "]"}]], "Input",ExpressionUUID->"bcf9f714-eea5-5440-8835-\
27817b9ed647"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4 Hasta qu\[EAcute] r sirve la serie", "Subsection",ExpressionUUID->"885e31e4-6091-ee47-b450-cee03c500e6d"],

Cell["\<\
Con K = 1, \[CapitalDelta] = 0 y \[ScriptCapitalE] = \[Kappa]p. Si los \
coeficientes c_j de \[Rho]10 crecen como |c_j| ~ \[Rho]^(\[Minus]j), el radio \
de convergencia en r es \[Rho]:\
\>", "Text",ExpressionUUID->"925ace78-b192-1148-b40d-8d7b2ecd736a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coefsK", " ", "=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ser", " ", "=", " ", 
       RowBox[{"serieK", "[", 
        RowBox[{"1", ",", " ", "0", ",", " ", "1", ",", " ", "24"}], "]"}]}], 
      "}"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"N", "[", 
        RowBox[{"ser", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"j", " ", "+", " ", "1"}], ",", " ", "2", ",", " ", "1"}], 
          "]"}], "]"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "0", ",", " ", "24"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"coefsK", "[", 
      RowBox[{"[", 
       RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], "]"}], "^", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "j"}], ")"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"j", ",", " ", "4", ",", " ", "24", ",", " ", "4"}], "}"}]}], 
  "]"}]}], "Input",ExpressionUUID->"0b92bbb6-ccd1-e945-9f4a-b065bc603b66"],

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rr", ",", " ", 
       RowBox[{"Im", "@", 
        RowBox[{
         RowBox[{"estBandaK", "[", 
          RowBox[{"24", ",", " ", "1", ",", " ", 
           RowBox[{"{", 
            RowBox[{"1.", ",", " ", 
             RowBox[{"N", "[", 
              RowBox[{"1", "/", "rr"}], "]"}], ",", " ", "0.", ",", " ", 
             "1."}], "}"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], ",", "\n", "    ", 
       RowBox[{"Im", "@", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rr", "^", "j"}], " ", 
           RowBox[{"coefsK", "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "12"}], "}"}]}], "]"}]}], ",",
        " ", 
       RowBox[{"Im", "@", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rr", "^", "j"}], " ", 
           RowBox[{"coefsK", "[", 
            RowBox[{"[", 
             RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"j", ",", " ", "0", ",", " ", "24"}], "}"}]}], "]"}]}]}], 
      "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"rr", ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.05", ",", " ", "0.1", ",", " ", "0.2", ",", " ", "0.3"}], 
        "}"}]}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<r\>\"", ",", " ", "\"\<banda K = 1 (Im \[Rho]10)\>\"", ",",
         " ", "\"\<serie hasta r^12\>\"", ",", 
        " ", "\"\<serie hasta r^24\>\""}], "}"}]}], "}"}]}]}], "]"}]], "Input",\
ExpressionUUID->"675c370a-92a6-f341-b24c-e3baa4ba02a0"],

Cell["\<\
El radio es del orden de 0,5\[Dash]0,6. Con 24 \[OAcute]rdenes la serie \
reproduce la banda hasta 10\:207b\:2079 con r = 0,2 y hasta 10\:207b\:2077 \
con r = 0,3. Para el l\[IAcute]mite cu\[AAcute]ntico (r \[LessTilde] 0,1) \
bastan pocos \[OAcute]rdenes.\
\>", "Text",ExpressionUUID->"b62919c8-1420-0546-b82d-2bd571884624"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.5 Resumen", "Subsection",ExpressionUUID->"bed7a67f-cc1f-6f4e-b1cf-49065b98c4c2"],

Cell["\<\
\[Bullet] El corte en k se puede hacer sin ning\[UAcute]n corte en \
n\[UAcute]mero: la jerarqu\[IAcute]a cortada en K, resuelta como funciones de \
z en serie de r, da la banda de vdp_corte_k.nb sin d.
\[Bullet] Cada orden es un polinomio en z de grado conocido. No hay que \
elegir cu\[AAcute]ntos niveles guardar.
\[Bullet] El orden 0 es Bloch. El orden r da la correcci\[OAcute]n \
1/\[Kappa]m en forma cerrada, y la diferencia entre K = 1 y K = 2 da el error \
del corte: r \[ScriptCapitalE]\.b3 en \[Rho]10 y r \[ScriptCapitalE]\:2074 en \
la paridad.
\[Bullet] La serie converge hasta r \[TildeTilde] 0,5, que cubre todo el l\
\[IAcute]mite cu\[AAcute]ntico.\
\>", "Text",ExpressionUUID->"1be26ab2-cc1f-3442-984d-ceab2d9ab7bd"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
