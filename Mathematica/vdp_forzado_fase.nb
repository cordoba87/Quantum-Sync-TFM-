         RowBox[{"M", ",", " ", "2"}], "]"}]}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"c", ",", " ", 
