Cell[BoxData[
 RowBox[{"MatrixForm", "[", 
  RowBox[{"matrizFock", "[", 
   RowBox[{"H", ",", " ", "d"}], "]"}], "]"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"f9e4250d-a07a-a14b-8169-c2e24fd14b0d"],

