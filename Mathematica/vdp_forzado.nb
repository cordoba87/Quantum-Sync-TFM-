Cell["\<\
Ahora con amplitud fija y varios desintonizados. Al crecer |\[CapitalDelta]|, \
el pico baja y se desplaza: la fase de anclaje deja de ser 3\[Pi]/2, igual \
que en Adler, donde sin \[Psi]* = \[Nu]/\[Epsilon].\
\>", "Text",ExpressionUUID->"c8b0d52f-d5fe-e94e-8287-6b37f386b0d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"P", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Kappa]p", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[CapitalDelta]", " ", "->", " ", "x"}], ",", " ", 
         RowBox[{"\[ScriptCapitalE]", " ", "->", " ", "2"}]}], "}"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1", ",", " ", "3", ",", " ", "6", ",", " ", 
          RowBox[{"-", "3"}]}], "}"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
