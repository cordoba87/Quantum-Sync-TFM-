           RowBox[{"2", " ", "\[CapitalDelta]"}], "+", 
           RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Kappa]p"}]}], ")"}]}], 
        RowBox[{"3", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", 
            SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
           RowBox[{"4", " ", 
            SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
           RowBox[{"9", " ", 
            SuperscriptBox["\[Kappa]p", "2"]}]}], ")"}]}]]}], 
      FractionBox[
       RowBox[{
        RowBox[{"3", " ", 
         SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
        RowBox[{"9", " ", 
         SuperscriptBox["\[Kappa]p", "2"]}]}], 
       RowBox[{
        RowBox[{"6", " ", 
         SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
        RowBox[{"12", " ", 
         SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
        RowBox[{"27", " ", 
         SuperscriptBox["\[Kappa]p", "2"]}]}]], "0"},
     {"0", "0", "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.0014203787332706`*^9},
 CellLabel->
  "Out[41]//MatrixForm=",ExpressionUUID->"859c84b7-0803-5344-ab33-\
9b5fcf390f9e"]
}, Open  ]],

Cell["\<\
En el marco rotante \[LeftAngleBracket]a\[RightAngleBracket] = Tr(a\[Rho]) = \
\[Rho]10. En el laboratorio \[LeftAngleBracket]a\[RightAngleBracket](t) = \
\[Rho]10 e^{\[Minus]i\[CapitalOmega]t}: el oscilador oscila a la frecuencia \
del forzamiento, no a \[Omega].\
\>", "Text",ExpressionUUID->"9e471f3b-487b-9946-831e-8f0a10cb09a2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"Tr", "[", 
   RowBox[{
    RowBox[{"matrizFock", "[", 
     RowBox[{"a", ",", " ", "d"}], "]"}], " ", ".", " ", "\[Rho]lim"}], "]"}],
   "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"bc84ea87-a3ed-624b-8638-17ac8212adcd"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"\[ScriptCapitalE]", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "\[CapitalDelta]"}], "+", 
      RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Kappa]p"}]}], ")"}]}], 
   RowBox[{"3", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
      RowBox[{"4", " ", 
       SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
      RowBox[{"9", " ", 
       SuperscriptBox["\[Kappa]p", "2"]}]}], ")"}]}]]}]], "Output",
 CellChangeTimes->{4.001420378747364*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"87ea5162-6039-0143-abc9-8da1a1419891"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Representaci\[OAcute]n de fase", "Section",ExpressionUUID->"e4570a7f-5e86-0849-ac74-497d876a0190"],

Cell["\<\
Diccionario de las notas (ecs. 41\[Dash]42), con D\[Theta] = i\[PartialD]\
\[Theta] y D\[Theta]p = \[Minus]i\[PartialD]\[Theta]p: a\[Rho] \[RightArrow] \
e^{i\[Theta]}\[Sqrt]D\[Theta] K, a\[Dagger]\[Rho] \[RightArrow] e^{\[Minus]i\
\[Theta]}\[Sqrt](D\[Theta]+1) K, \[Rho]a \[RightArrow] \
e^{i\[Theta]p}\[Sqrt](D\[Theta]p+1) K, \[Rho]a\[Dagger] \[RightArrow] e^{\
\[Minus]i\[Theta]p}\[Sqrt]D\[Theta]p K. Ejemplo con \[Rho] = |2\
\[RightAngleBracket]\[LeftAngleBracket]1|:\
\>", "Text",ExpressionUUID->"47fc276a-935b-7542-96d9-1647b1d5abe3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"K21", " ", "=", " ", 
   RowBox[{"nucleo", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"\"\<a\[Rho]\>\"", ",", " ", 
      RowBox[{"accionIzq", "[", 
       RowBox[{"a", ",", " ", "K21"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<a\[Dagger]\[Rho]\>\"", ",", " ", 
      RowBox[{"accionIzq", "[", 
       RowBox[{"ad", ",", " ", "K21"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Rho]a\>\"", ",", " ", 
      RowBox[{"accionDer", "[", 
       RowBox[{"a", ",", " ", "K21"}], "]"}]}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Rho]a\[Dagger]\>\"", ",", " ", 
      RowBox[{"accionDer", "[", 
       RowBox[{"ad", ",", " ", "K21"}], "]"}]}], "}"}]}], "}"}], 
  "]"}]}], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"7abbacb0-8057-1744-bba8-1bac9f15b4c0"],

Cell[BoxData[
 TagBox[GridBox[{
    {"\<\"a\[Rho]\"\>", 
     RowBox[{
      SqrtBox["2"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Theta]p"}]}]]}]},
    {"\<\"a\[Dagger]\[Rho]\"\>", 
     RowBox[{
      SqrtBox["3"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "3"}], " ", "\[ImaginaryI]", " ", "\[Theta]"}], "+", 
        RowBox[{"\[ImaginaryI]", " ", "\[Theta]p"}]}]]}]},
    {"\<\"\[Rho]a\"\>", 
     RowBox[{
      SqrtBox["2"], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Theta]"}], "+", 
        RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[Theta]p"}]}]]}]},
    {"\<\"\[Rho]a\[Dagger]\"\>", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "\[Theta]"}]]}
   },
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
   GridBoxSpacings->{"Columns" -> {
       Offset[0.27999999999999997`], {
        Offset[2.0999999999999996`]}, 
       Offset[0.27999999999999997`]}, "Rows" -> {
       Offset[0.2], {
        Offset[0.4]}, 
       Offset[0.2]}}],
  Function[BoxForm`e$, 
   TableForm[BoxForm`e$]]]], "Output",
 CellChangeTimes->{4.0014203787523537`*^9},
 CellLabel->
  "Out[44]//TableForm=",ExpressionUUID->"53123271-4d86-5d4f-af1f-\
bc55e05455b6"]
}, Open  ]],

Cell["\<\
N\[UAcute]cleo y distribuci\[OAcute]n de fase en el l\[IAcute]mite \
cu\[AAcute]ntico. Ahora K tiene los t\[EAcute]rminos e^{\[Minus]i\[Theta]} y \
e^{i\[Theta]p} sueltos (los de \[Rho]10 y \[Rho]01), y por eso P(\[Theta]) \
deja de ser plana:\
\>", "Text",ExpressionUUID->"f46857ac-38fe-5b4f-88b5-1a8c91293dd4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"K", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{"nucleo", "[", "\[Rho]lim", "]"}], "]"}]}]], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"cd424873-6429-c740-9875-917d634f0439"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Theta]"}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{"\[Theta]", "+", "\[Theta]p"}], ")"}]}]], " ", 
      "\[ScriptCapitalE]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[CapitalDelta]"}], "+", 
        RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Kappa]p"}]}], ")"}]}], "-", 
     RowBox[{"\[ScriptCapitalE]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "\[CapitalDelta]"}], "+", 
        RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Kappa]p"}]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]p"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
        RowBox[{"9", " ", 
         SuperscriptBox["\[Kappa]p", "2"]}]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"3", " ", 
         SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
        RowBox[{"18", " ", 
         SuperscriptBox["\[Kappa]p", "2"]}]}], ")"}]}]}], ")"}]}], 
  RowBox[{"3", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", 
      SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
     RowBox[{"4", " ", 
      SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
     RowBox[{"9", " ", 
      SuperscriptBox["\[Kappa]p", "2"]}]}], ")"}]}]]], "Output",
 CellChangeTimes->{4.0014203787787*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"363ac7d5-d831-174e-b4e1-1d7f70907ac4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"P", " ", "=", " ", 
  RowBox[{"distribucionFase", "[", "\[Rho]lim", "]"}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"e3305b00-fc5b-fa45-9c38-0cdd29c64f23"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"6", " ", 
    SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
   RowBox[{"12", " ", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
   RowBox[{"27", " ", 
    SuperscriptBox["\[Kappa]p", "2"]}], "-", 
   RowBox[{"4", " ", "\[ScriptCapitalE]", " ", "\[CapitalDelta]", " ", 
    RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "-", 
   RowBox[{"6", " ", "\[ScriptCapitalE]", " ", "\[Kappa]p", " ", 
    RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], 
  RowBox[{
   RowBox[{"12", " ", "\[Pi]", " ", 
    SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
   RowBox[{"24", " ", "\[Pi]", " ", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
   RowBox[{"54", " ", "\[Pi]", " ", 
    SuperscriptBox["\[Kappa]p", "2"]}]}]]], "Output",
 CellChangeTimes->{4.001420378812443*^9},
 CellLabel->"Out[46]=",ExpressionUUID->"430e1475-509d-814d-bee4-89b2302bcb4d"]
}, Open  ]],

Cell["\<\
Comprobaciones del diccionario: la ecuaci\[OAcute]n de Lindblad en fase (con \
el t\[EAcute]rmino del forzamiento) coincide con la de Fock, y el \
n\[UAcute]cleo estacionario exacto de 3 niveles cumple \[PartialD]t K = 0. \
Para esto \[UAcute]ltimo hay que usar \[Rho]ss (con \[Kappa]m finito): \
\[Rho]lim solo es el orden dominante. Tarda unos segundos.\
\>", "Text",ExpressionUUID->"d03b9289-2c99-7c45-96da-ef743fbebaa2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"comprobarDiccionario", "[", 
  RowBox[{"H", ",", " ", "saltos", ",", " ", "d"}], "]"}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"f6c06f58-6f35-4741-934d-5bb2ee2c4a09"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0014203788326435`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"dde3f5b4-cbc2-ee4b-a810-4864b904233d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"matrizDeNucleo", "[", 
   RowBox[{
    RowBox[{"lindbladFase", "[", 
     RowBox[{
      RowBox[{"nucleo", "[", "\[Rho]ss", "]"}], ",", " ", "H", ",", " ", 
      "saltos", ",", " ", "d"}], "]"}], ",", " ", "d"}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"803d4224-b69b-cb41-90fb-7377cdf9ceea"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0014203873081703`*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"e475d29d-e26f-d142-885b-6ce1c63db51d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. Distribuci\[OAcute]n de fase", "Section",ExpressionUUID->"bbd02df0-8ae4-7044-b14a-cc8c8c05f0b1"],

Cell["\<\
\[CapitalDelta] = \[Omega] \[Minus] \[CapitalOmega] es un par\[AAcute]metro: \
lo fija quien pone el forzamiento. Primero, en resonancia (\[CapitalDelta] = \
0) y con varias amplitudes, en el l\[IAcute]mite cu\[AAcute]ntico. El pico \
est\[AAcute] en \[Theta] = 3\[Pi]/2, la fase que da Lee para \[CapitalDelta] \
= 0.\
\>", "Text",ExpressionUUID->"5d583e85-4a6e-9e46-b7af-860e3645e1b6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"P", " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Kappa]p", " ", "->", " ", "1"}], ",", " ", 
         RowBox[{"\[CapitalDelta]", " ", "->", " ", "0"}], ",", " ", 
         RowBox[{"\[ScriptCapitalE]", " ", "->", " ", "x"}]}], "}"}]}], ",", 
      " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.5", ",", " ", "1", ",", " ", "2", ",", " ", "5"}], 
         "}"}]}], "}"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
     RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"PlotRange", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", " ", "0.25"}], "}"}]}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(\[Theta])\>\""}], "}"}]}], ",",
    "\n", " ", 
   RowBox[{"FrameTicks", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Automatic", ",", " ", "None"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
   RowBox[{"GridLines", " ", "->", " ", 
    RowBox[{"{", 
