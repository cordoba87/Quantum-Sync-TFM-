Cell[CellGroupData[{

Cell["6. Lengua de Arnold", "Section",ExpressionUUID->"4ae22074-42e3-8d45-9c85-60dbb5935a46"],

Cell["\<\
P(\[Theta]) = [1 + 2|\[Rho]10| cos(\[Theta] \[Minus] arg \[Rho]10)]/2\[Pi], \
as\[IAcute] que |\[Rho]10| mide cu\[AAcute]nto se sincroniza el oscilador con \
el forzamiento. Mapa de |\[Rho]10| en el plano (\[CapitalDelta], \
\[ScriptCapitalE]), en el l\[IAcute]mite cu\[AAcute]ntico y en unidades de \
\[Kappa]p. Comp\[AAcute]ralo con la lengua de Adler del paso 2: \
\[DownQuestion]d\[OAcute]nde est\[AAcute] el m\[AAcute]ximo para cada \
\[CapitalDelta], y cu\[AAcute]nto vale?\
\>", "Text",ExpressionUUID->"e281b767-ba5b-7d42-9b18-fcc50ac039d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"mod\[Rho]10", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"\[Rho]lim", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"651bc5b4-5e72-2449-8691-492eb107ae90"],

Cell[BoxData[
 FractionBox[
  RowBox[{"\[ScriptCapitalE]", " ", 
   SqrtBox[
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
     RowBox[{"9", " ", 
      SuperscriptBox["\[Kappa]p", "2"]}]}]]}], 
  RowBox[{
   RowBox[{"6", " ", 
    SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
   RowBox[{"12", " ", 
    SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
   RowBox[{"27", " ", 
    SuperscriptBox["\[Kappa]p", "2"]}]}]]], "Output",
 CellChangeTimes->{4.001420387875126*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"5c76320e-3ee0-374f-9219-86404aa69ea9"]
}, Open  ]],

