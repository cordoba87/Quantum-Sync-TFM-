 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      FractionBox[
       RowBox[{
        RowBox[{"3", " ", 
         SuperscriptBox["\[ScriptCapitalE]", "2"]}], "+", 
        RowBox[{"8", " ", 
         SuperscriptBox["\[CapitalDelta]", "2"]}], "+", 
        RowBox[{"18", " ", 
