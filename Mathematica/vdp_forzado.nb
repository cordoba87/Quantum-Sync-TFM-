 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      FractionBox["\[ScriptCapitalE]", "2"], "0"},
     {
      FractionBox["\[ScriptCapitalE]", "2"], "\[CapitalDelta]", 
      FractionBox["\[ScriptCapitalE]", 
       SqrtBox["2"]]},
     {"0", 
      FractionBox["\[ScriptCapitalE]", 
       SqrtBox["2"]], 
      RowBox[{"2", " ", "\[CapitalDelta]"}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
