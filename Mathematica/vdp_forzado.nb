        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
     "}"}]}], ",", " ", 
