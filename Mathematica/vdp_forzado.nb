      RowBox[{"{", 
       RowBox[{"3", " ", 
        RowBox[{"Pi", "/", "2"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}]}], "}"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[ScriptCapitalE] = 0.5\>\"", ",", 
      " ", "\"\<\[ScriptCapitalE] = 1\>\"", ",", 
      " ", "\"\<\[ScriptCapitalE] = 2\>\"", ",", 
      " ", "\"\<\[ScriptCapitalE] = 5\>\""}], "}"}]}]}], "]"}]], "Input",
