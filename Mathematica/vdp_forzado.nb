Cell[CellGroupData[{

Cell["7. El n\[UAcute]cleo de fase K(\[Theta], \[Theta]p)", "Section",ExpressionUUID->"17531574-9391-c94e-b6ad-5b20c62407b9"],

Cell["\<\
K es complejo y depende de dos \[AAcute]ngulos, as\[IAcute] que se dibujan su \
m\[OAcute]dulo y su fase en el cuadrado [0, 2\[Pi]]\[Times][0, 2\[Pi]]. La \
diagonal \[Theta] = \[Theta]p (l\[IAcute]nea discontinua) es \
2\[Pi]P(\[Theta]). Lo que se aleja de la diagonal son las coherencias entre \
fases distintas: dependen de \[CurlyPhi] = \[Theta] \[Minus] \[Theta]p y \
guardan las poblaciones. Izquierda, sin forzamiento (\[ScriptCapitalE] = 0): \
K solo depende de \[Theta] \[Minus] \[Theta]p y salen bandas paralelas a la \
diagonal. Derecha, con forzamiento: los t\[EAcute]rminos \
e^{\[Minus]i\[Theta]} y e^{i\[Theta]p} rompen esa simetr\[IAcute]a.\
\>", "Text",ExpressionUUID->"29deca1e-e22b-aa4f-8212-1563355079d4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Kn", "[", 
    RowBox[{"amp_", ",", " ", "det_"}], "]"}], " ", ":=", " ", 
   RowBox[{"K", " ", "/.", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Kappa]p", " ", "->", " ", "1"}], ",", " ", 
      RowBox[{"\[CapitalDelta]", " ", "->", " ", "det"}], ",", " ", 
      RowBox[{"\[ScriptCapitalE]", " ", "->", " ", "amp"}]}], "}"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ticks", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"2", " ", "Pi"}], ",", " ", 
         RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", " ", 
         RowBox[{"2", " ", "Pi"}], ",", " ", 
         RowBox[{"Pi", "/", "2"}]}], "]"}], ",", " ", "None"}], "}"}]}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"panelK", "[", 
    RowBox[{
    "f_", ",", " ", "rango_", ",", " ", "colores_", ",", " ", "etiqueta_", ",",
      " ", "amp_", ",", " ", "det_"}], "]"}], " ", ":=", " ", 
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"Kn", "[", 
       RowBox[{"amp", ",", " ", "det"}], "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]p", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotPoints", " ", "->", " ", "40"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "rango"}], ",", " ", 
     RowBox[{"ColorFunction", " ", "->", " ", "colores"}], ",", " ", 
     RowBox[{"ColorFunctionScaling", " ", "->", " ", "False"}], ",", "\n", 
     "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}], ",", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<\[Theta]p\>\""}], "}"}]}], ",",
      " ", 
     RowBox[{"FrameTicks", " ", "->", " ", "ticks"}], ",", " ", 
     RowBox[{"PlotLabel", " ", "->", " ", "etiqueta"}], ",", "\n", "  ", 
     RowBox[{"Epilog", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"White", ",", " ", "Dashed", ",", " ", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", " ", "Pi"}], ",", " ", 
             RowBox[{"2", " ", "Pi"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",",
      " ", 
     RowBox[{"ImageSize", " ", "->", " ", "280"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[56]:=",ExpressionUUID->"fa6172a6-1aea-9b4f-8180-354d903afcf5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"modulo", " ", "=", " ", 
   RowBox[{"ColorData", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<SunsetColors\>\"", ",", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.3"}], "}"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fase", " ", "=", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Hue", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"#", " ", "+", " ", "Pi"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "Pi"}], ")"}]}], "]"}], " ", "&"}], ")"}]}], 
  ";"}], "\n", 
 RowBox[{"Grid", "[", 
  RowBox[{"{", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"panelK", "[", 
       RowBox[{"Abs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.3"}], "}"}], ",", " ", "modulo", ",", 
        " ", "\"\<|K|, \[ScriptCapitalE] = 0\>\"", ",", " ", "0", ",", " ", 
        "0"}], "]"}], ",", " ", 
      RowBox[{"panelK", "[", 
       RowBox[{"Abs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.3"}], "}"}], ",", " ", "modulo", ",", 
        " ", "\"\<|K|, \[ScriptCapitalE] = 2, \[CapitalDelta] = 0\>\"", ",", 
        " ", "2", ",", " ", "0"}], "]"}]}], "}"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"panelK", "[", 
       RowBox[{"Arg", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", "fase", ",",
         " ", "\"\<arg K, \[ScriptCapitalE] = 0\>\"", ",", " ", "0", ",", " ",
         "0"}], "]"}], ",", " ", 
      RowBox[{"panelK", "[", 
       RowBox[{"Arg", ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "Pi"}], ",", " ", "Pi"}], "}"}], ",", " ", "fase", ",",
         " ", "\"\<arg K, \[ScriptCapitalE] = 2, \[CapitalDelta] = 0\>\"", ",",
         " ", "2", ",", " ", "0"}], "]"}]}], "}"}]}], "}"}], "]"}]}], "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"b4f46b94-f05c-5948-b1ca-df79c14494e9"],

