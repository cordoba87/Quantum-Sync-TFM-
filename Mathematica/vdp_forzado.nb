      FractionBox[
       RowBox[{"\[ScriptCapitalE]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[CapitalDelta]"}], "+", 
          RowBox[{"3", " ", "\[ImaginaryI]", " ", "\[Kappa]p"}]}], ")"}]}], 
       RowBox[{"3", " ", 
        RowBox[{"(", 
         RowBox[{
