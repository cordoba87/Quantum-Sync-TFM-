       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", "Pi"}], ")"}]}], "}"}]}], "}"}]}], ",", "\n", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalDelta] = 0\>\"", ",", 
      " ", "\"\<\[CapitalDelta] = 1\>\"", ",", 
      " ", "\"\<\[CapitalDelta] = 3\>\"", ",", 
      " ", "\"\<\[CapitalDelta] = 6\>\"", ",", 
      " ", "\"\<\[CapitalDelta] = \[Minus]3\>\""}], "}"}]}]}], "]"}]], "Input",
