          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"2", " ", "Pi"}]}], "}"}]}], "}"}], "]"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ejesK", " ", "=", " ", 
