      RowBox[{"medidaR", "[", "r", "]"}], " ", "-", " ", 
      RowBox[{"medidaR", "[", "ref", "]"}]}], "]"}], "/", 
    RowBox[{"medidaR", "[", "ref", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nElementos", "[", 
    RowBox[{"l_", ",", " ", "kk_"}], "]"}], " ", ":=", " ", 
