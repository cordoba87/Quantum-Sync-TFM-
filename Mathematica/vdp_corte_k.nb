Cell["\<\
C\[OAcute]mo mejora al subir K: error de \[Rho]10 respecto a todos los \
sectores. Con K = 0 no hay coherencias (son las poblaciones sin forzamiento); \
cada sector m\[AAcute]s gana varios \[OAcute]rdenes de magnitud.\
\>", "Text",ExpressionUUID->"e41d1797-c48e-e54e-b66a-25012ccd9c33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", " ", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]K", "[", "k", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
         RowBox[{"ref", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<K\>\"", ",", 
        " ", "\"\<|\[Rho]10(K) \[Minus] \[Rho]10(todos)|\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]], "Input",
