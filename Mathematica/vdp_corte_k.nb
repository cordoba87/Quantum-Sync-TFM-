Cell[CellGroupData[{

Cell["5. Lengua de Arnold", "Section",ExpressionUUID->"81da98a7-b837-7f46-9c7c-9861918602d0"],

Cell["\<\
Mapa de |\[Rho]10| en el plano (\[CapitalDelta], \[ScriptCapitalE]): cu\
\[AAcute]nto se engancha la fase al forzamiento (secci\[OAcute]n 3). A la \
izquierda, con el corte K elegido en la secci\[OAcute]n 3; a la derecha, el l\
\[IAcute]mite cu\[AAcute]ntico usual. Tarda unos segundos.\
\>", "Text",ExpressionUUID->"fda7b299-115d-8246-b6c6-203c54548ddc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mod10", "[", 
    RowBox[{
     RowBox[{"\[Delta]_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"e_", "?", "NumericQ"}], ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[CapitalDelta]", " ", "=", " ", "\[Delta]"}], ",", " ", 
       RowBox[{"\[ScriptCapitalE]", " ", "=", " ", "e"}]}], "}"}], ",", " ", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"\[Rho]K", "[", "k", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mod10usual", "[", 
    RowBox[{"\[Delta]_", ",", " ", "e_"}], "]"}], " ", ":=", " ", 
   RowBox[{"e", " ", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"9", " ", 
        RowBox[{"\[Kappa]p", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"4", " ", 
        RowBox[{"\[Delta]", "^", "2"}]}]}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"27", " ", 
        RowBox[{"\[Kappa]p", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"12", " ", 
        RowBox[{"\[Delta]", "^", "2"}]}], " ", "+", " ", 
       RowBox[{"6", " ", 
        RowBox[{"e", "^", "2"}]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"opciones", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotPoints", " ", "->", " ", "30"}], ",", " ", 
     RowBox[{"ColorFunction", " ", "->", " ", "\"\<SunsetColors\>\""}], ",", 
     " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[CapitalDelta]/\[Kappa]p\>\"", ",", 
        " ", "\"\<\[ScriptCapitalE]/\[Kappa]p\>\""}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", "Automatic"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"mod10", "[", 
        RowBox[{"\[Delta]", ",", " ", "e", ",", " ", "K"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", " ", 
         RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"Evaluate", "[", "opciones", "]"}], ",", " ", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"\"\<|\[Rho]10|, corte |k| \[LessEqual] \>\"", " ", "<>", " ", 
         RowBox[{"ToString", "[", "K", "]"}]}]}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{"mod10usual", "[", 
        RowBox[{"\[Delta]", ",", " ", "e"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\[Delta]", ",", " ", 
         RowBox[{"-", "4"}], ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"e", ",", " ", "0", ",", " ", "6"}], "}"}], ",", " ", 
       RowBox[{"Evaluate", "[", "opciones", "]"}], ",", " ", 
       RowBox[{
       "PlotLabel", " ", "->", 
        " ", "\"\<|\[Rho]10|, l\[IAcute]mite cu\[AAcute]ntico usual\>\""}]}], 
      "]"}]}], "}"}], ",", "\n", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]}], "Input",
