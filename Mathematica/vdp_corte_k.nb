Cell["\<\
El l\[IAcute]mite cu\[AAcute]ntico usual difiere de \[LeftGuillemet]todos los \
sectores\[RightGuillemet] en una cantidad de orden 1/\[Kappa]m: es el error \
de quedarse solo con |0\:27e9 y |1\:27e9, no el del corte en k.\
\>", "Text",ExpressionUUID->"858e1678-c259-f346-b5cc-08dcb963a862"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. La distribuci\[OAcute]n de fase seg\[UAcute]n el corte", "Section",ExpressionUUID->"eed3d266-3a9f-9143-adad-ff12313236d6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Pnum", "[", 
    RowBox[{"\[Rho]_", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Rho]", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"n", " ", "+", " ", "1"}], ",", " ", 
           RowBox[{"m", " ", "+", " ", "1"}]}], "]"}], "]"}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"n", " ", "-", " ", "m"}], ")"}], " ", "t"}], "]"}]}], ",",
        " ", 
       RowBox[{"{", 
        RowBox[{"n", ",", " ", "0", ",", " ", 
         RowBox[{"d", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "0", ",", " ", 
         RowBox[{"d", " ", "-", " ", "1"}]}], "}"}]}], "]"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", " ", "Pi"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Manipulate", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Pnum", "[", 
        RowBox[{
         RowBox[{"\[Rho]K", "[", "K", "]"}], ",", " ", "t"}], "]"}], ",", " ", 
       RowBox[{"Pnum", "[", 
        RowBox[{"ref", ",", " ", "t"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", " ", 
     RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", "\n", "  ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", "Dashed"}], "}"}]}], ",", " ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<|k| \[LessEqual] K\>\"", ",", 
        " ", "\"\<todos los sectores\>\""}], "}"}]}], ",", "\n", "  ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\[Theta]\>\"", ",", " ", "\"\<P(\[Theta])\>\""}], 
       "}"}]}]}], "]"}], ",", "\n", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"K", ",", " ", "1"}], "}"}], ",", " ", "0", ",", " ", 
     RowBox[{"d", " ", "-", " ", "1"}], ",", " ", "1"}], "}"}]}], 
  "]"}]}], "Input",
 CellLabel->
  "In[235]:=",ExpressionUUID->"65f9dec4-7330-4048-a896-60b7c29ffe63"],

