 RowBox[{
  RowBox[{
   RowBox[{"banda", "[", 
    RowBox[{"kk_", ",", " ", "par_"}], "]"}], " ", ":=", " ", 
   RowBox[{"errNucleo", "[", 
    RowBox[{
     RowBox[{"estBanda", "[", 
