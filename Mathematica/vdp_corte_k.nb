Notebook[{

Cell[CellGroupData[{
Cell["\<\
VdP forzado en el l\[IAcute]mite cu\[AAcute]ntico: estacionario con corte en k\
\>", "Title",ExpressionUUID->"34b394e1-a359-c64d-9eca-f7b9a990e4f4"],

Cell["\<\
Se construye la ecuaci\[OAcute]n de Lindblad en las dos coordenadas de fase, \
(\[Theta], \[Theta]') y (\[CapitalTheta], \[CurlyPhi]), se comprueba que dan \
la misma matriz que Fock y se calcula el estacionario guardando solo los \
sectores |k| \[LessEqual] K. Convenios de las notas: H = \[CapitalDelta] a\
\[Dagger]a + (\[ScriptCapitalE]/2)(a + a\[Dagger]) en el marco del \
forzamiento, \[Kappa]p \|01d49f[a\[Dagger]] + \[Kappa]m \|01d49f[a\.b2]. En \
Mathematica E es el n\[UAcute]mero e: la amplitud es \[ScriptCapitalE].\
\>", "Text",ExpressionUUID->"e09fbd22-ebe6-af4e-a850-d2ff94570b13"],

Cell[CellGroupData[{

Cell["0. Paquete y par\[AAcute]metros", "Section",ExpressionUUID->"bf2591e1-4c76-654f-a68e-1afd81fcb948"],

Cell[BoxData[
 RowBox[{"Get", "[", 
  RowBox[{"FileNameJoin", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"NotebookDirectory", "[", "]"}], ",", 
     " ", "\"\<RepresentacionFase.wl\>\""}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->
  "In[210]:=",ExpressionUUID->"b1128f99-82d1-3d44-9e3c-9f03cea9a3cf"],

Cell["\<\
L\[IAcute]mite cu\[AAcute]ntico: r = \[Kappa]p/\[Kappa]m \[LessLess] 1. d es \
el largo de cada diagonal (niveles de Fock) y no depende de K.\
\>", "Text",ExpressionUUID->"fb07ed60-2492-a242-b946-afac93dc9e98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Kappa]p", " ", "=", " ", "1"}], ";", " ", 
  RowBox[{"\[Kappa]m", " ", "=", " ", "50"}], ";", " ", 
  RowBox[{"\[CapitalDelta]", " ", "=", " ", 
   RowBox[{"1", "/", "2"}]}], ";", " ", 
  RowBox[{"\[ScriptCapitalE]", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"d", " ", "=", " ", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"H", " ", "=", " ", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", " ", 
     RowBox[{"ad", " ", "**", " ", "a"}]}], " ", "+", " ", 
    RowBox[{
     RowBox[{"\[ScriptCapitalE]", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"a", " ", "+", " ", "ad"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"saltos", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Kappa]p", ",", " ", 
       RowBox[{"+", "1"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\[Kappa]m", ",", " ", 
       RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], ";"}]}], "Input",
 CellLabel->
  "In[211]:=",ExpressionUUID->"2aea6066-5615-4346-85dd-53f3e5f10346"]
}, Open  ]],

Cell[CellGroupData[{

Cell["1. Fase (\[Theta], \[Theta]')", "Section",ExpressionUUID->"c5602a4d-1344-2f46-ae91-e929c43d1342"],

Cell["\<\
liouvillianoDesdeFase aplica la ecuaci\[OAcute]n del n\[UAcute]cleo con el \
diccionario de las notas (a\[Rho] \[RightArrow] \
e^{i\[Theta]}\[Sqrt]D_\[Theta] K, \[Ellipsis]) a cada modo \
e^{-in\[Theta]}e^{im\[Theta]'} y lee sus coeficientes. Tiene que salir la \
matriz de Fock.\
\>", "Text",ExpressionUUID->"53882eab-6c2d-7748-a5d2-95df7728126e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[ScriptCapitalL]fase", " ", "=", " ", 
   RowBox[{"liouvillianoDesdeFase", "[", 
    RowBox[{"H", ",", " ", "saltos", ",", " ", "d"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"\[ScriptCapitalL]fase", " ", "-", " ", 
    RowBox[{"liouvilliano", "[", 
     RowBox[{"H", ",", " ", "saltos", ",", " ", "d"}], "]"}]}], "]"}], " ", "===",
   " ", 
  RowBox[{"ConstantArray", "[", 
   RowBox[{"0", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"d", "^", "2"}], ",", " ", 
      RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"01a13d7e-bdfd-a14f-b79e-86a86a829d5f"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0033153632918777`*^9, 4.0033158084672985`*^9},
 CellLabel->
  "Out[216]=",ExpressionUUID->"7d4b9332-484d-2d49-8351-6fbfaa081c0a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Centro y diferencia (\[CapitalTheta], \[CurlyPhi]): la matriz por \
sectores", "Section",ExpressionUUID->"08382f9b-ed35-c647-b8d4-ce17a1e23bb6"],

Cell["\<\
Los bloques de la \[Section]6 de las notas, sobre los c_n = \[Rho]_{n+k,n} de \
cada sector (k \[GreaterEqual] 0), con el corte de Fock en el nivel d \
\[Minus] 1.\
\>", "Text",ExpressionUUID->"763acc0a-2c83-3241-a73b-faff7ebe8fba"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dsec", "[", 
    RowBox[{"n_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Kappa]p"}], " ", 
     RowBox[{"(", 
      RowBox[{"n", " ", "+", " ", "1", " ", "+", " ", 
       RowBox[{"k", "/", "2"}]}], ")"}]}], " ", "-", " ", 
    RowBox[{
     RowBox[{"\[Kappa]m", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"n", " ", "+", " ", "k"}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "+", " ", "k", " ", "-", " ", "1"}], ")"}]}], " ", 
       "+", " ", 
       RowBox[{"n", " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "-", " ", "1"}], ")"}]}]}], ")"}]}], " ", "+", 
    "\n", "   ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"n", " ", "+", " ", "k"}], " ", "==", " ", 
       RowBox[{"d", " ", "-", " ", "1"}]}], ",", " ", 
      RowBox[{
       RowBox[{"\[Kappa]p", " ", 
        RowBox[{"(", 
         RowBox[{"n", " ", "+", " ", "1", " ", "+", " ", 
          RowBox[{"k", "/", "2"}]}], ")"}]}], " ", "-", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"k", " ", ">", " ", "0"}], ",", " ", 
         RowBox[{"\[Kappa]p", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d", " ", "-", " ", "k"}], ")"}], "/", "2"}]}], ",", " ", 
         "0"}], "]"}]}], ",", " ", "0"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Lk", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"i", " ", "==", " ", "j"}], ",", " ", 
       RowBox[{"dsec", "[", 
        RowBox[{"j", ",", " ", "k"}], "]"}], ",", " ", 
       RowBox[{"i", " ", "==", " ", 
        RowBox[{"j", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{"\[Kappa]p", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"j", " ", "+", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "+", " ", "k", " ", "+", " ", "1"}], ")"}]}], 
         "]"}]}], ",", "\n", "    ", 
       RowBox[{"i", " ", "==", " ", 
        RowBox[{"j", " ", "-", " ", "2"}]}], ",", " ", 
       RowBox[{"\[Kappa]m", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"j", " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "+", " ", "k"}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"j", " ", "+", " ", "k", " ", "-", " ", "1"}], ")"}]}], 
         "]"}]}], ",", " ", "True", ",", " ", "0"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1", " ", "-", " ", "k"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1", " ", "-", " ", "k"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ak", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"j", " ", "==", " ", "i"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "I"}], "/", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"i", " ", "+", " ", "k"}], "]"}]}], ",", " ", 
       RowBox[{"j", " ", "==", " ", 
        RowBox[{"i", " ", "+", " ", "1"}]}], ",", " ", 
       RowBox[{
        RowBox[{"I", "/", "2"}], " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"i", " ", "+", " ", "1"}], "]"}]}], ",", " ", "True", ",", 
       " ", "0"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "1", " ", "-", " ", "k"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "0", ",", " ", 
       RowBox[{"d", " ", "-", " ", "k"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bk", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Ak", "[", 
     RowBox[{"k", " ", "+", " ", "1"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[217]:=",ExpressionUUID->"dde01f28-7299-524e-a262-a63767390785"],

Cell["\<\
La matriz tridiagonal por bloques con los sectores k = \[Minus]K, \
\[Ellipsis], K. Las filas de k < 0 son las conjugadas de las de k > 0, porque \
x_{\[Minus]k} = x\:0304_k: como \|01d49c_k y \|01d4d1_k son \[Minus]i/2 por \
una matriz real, sus bloques del forzamiento llevan el signo cambiado.\
\>", "Text",ExpressionUUID->"8a79b19c-4474-a145-92b8-48373cf41328"],

Cell[BoxData[
 RowBox[{
  RowBox[{"matrizSectores", "[", "K_", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "bloque", "}"}], ",", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"bloque", "[", 
       RowBox[{"r_", ",", " ", "c_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Which", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"r", " ", "==", " ", "c"}], ",", " ", 
        RowBox[{
         RowBox[{"Lk", "[", 
          RowBox[{"Abs", "[", "r", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"I", " ", "r", " ", "\[CapitalDelta]", " ", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"d", " ", "-", " ", 
            RowBox[{"Abs", "[", "r", "]"}]}], "]"}]}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", ">=", " ", "1"}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", 
          RowBox[{"r", " ", "-", " ", "1"}]}]}], ",", " ", 
        RowBox[{"\[ScriptCapitalE]", " ", 
         RowBox[{"Ak", "[", "r", "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", ">=", " ", "1"}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", 
          RowBox[{"r", " ", "+", " ", "1"}]}]}], ",", " ", 
        RowBox[{"\[ScriptCapitalE]", " ", 
         RowBox[{"Bk", "[", "r", "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", "==", " ", "0"}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", "1"}]}], ",", " ", 
        RowBox[{"\[ScriptCapitalE]", " ", 
         RowBox[{"Bk", "[", "0", "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", "==", " ", "0"}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", 
          RowBox[{"-", "1"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"-", "\[ScriptCapitalE]"}], " ", 
         RowBox[{"Bk", "[", "0", "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", "<=", " ", 
          RowBox[{"-", "1"}]}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", 
          RowBox[{"r", " ", "-", " ", "1"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"-", "\[ScriptCapitalE]"}], " ", 
         RowBox[{"Bk", "[", 
          RowBox[{"-", "r"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"r", " ", "<=", " ", 
          RowBox[{"-", "1"}]}], " ", "&&", " ", 
         RowBox[{"c", " ", "==", " ", 
          RowBox[{"r", " ", "+", " ", "1"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"-", "\[ScriptCapitalE]"}], " ", 
         RowBox[{"Ak", "[", 
          RowBox[{"-", "r"}], "]"}]}], ",", "\n", "    ", "True", ",", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"d", " ", "-", " ", 
             RowBox[{"Abs", "[", "r", "]"}]}], ",", " ", 
            RowBox[{"d", " ", "-", " ", 
             RowBox[{"Abs", "[", "c", "]"}]}]}], "}"}]}], "]"}]}], "]"}]}], ";",
      "\n", "  ", 
     RowBox[{"ArrayFlatten", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"bloque", "[", 
         RowBox[{"r", ",", " ", "c"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"r", ",", " ", 
          RowBox[{"-", "K"}], ",", " ", "K"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", 
          RowBox[{"-", "K"}], ",", " ", "K"}], "}"}]}], "]"}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellLabel->
  "In[221]:=",ExpressionUUID->"679a0da3-f8a7-664b-9a79-dabd522d285d"],

Cell["\<\
Con todos los sectores (K = d \[Minus] 1) tiene que ser la matriz de \
(\[Theta], \[Theta]') reordenada por sectores.\
\>", "Text",ExpressionUUID->"e9908f8f-9475-3e4a-8f85-27130158d1a9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"o", " ", "=", " ", 
   RowBox[{"ordenPorSectores", "[", "d", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"matrizSectores", "[", 
     RowBox[{"d", " ", "-", " ", "1"}], "]"}], " ", "-", " ", 
    RowBox[{"\[ScriptCapitalL]fase", "[", 
     RowBox[{"[", 
      RowBox[{"o", ",", " ", "o"}], "]"}], "]"}]}], "]"}], " ", "===", " ", 
  RowBox[{"ConstantArray", "[", 
   RowBox[{"0", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"d", "^", "2"}], ",", " ", 
      RowBox[{"d", "^", "2"}]}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"9b3eeb95-5295-324c-9ca2-7084617c2823"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.0033153633160954`*^9, 4.003315808501503*^9},
 CellLabel->
  "Out[223]=",ExpressionUUID->"748ae4d9-ed45-2545-a1a7-e03bf597812e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Estacionario con corte en K", "Section",ExpressionUUID->"d2716770-2bb4-7149-b936-f444e473ef7d"],

Cell["\<\
Se guardan los sectores |k| \[LessEqual] K enteros y se tira el resto. \
\[Rho]K usa la matriz por sectores; \[Rho]Kfase, la de (\[Theta], \[Theta]') \
restringida a los mismos modos. Tienen que coincidir.\
\>", "Text",ExpressionUUID->"da13a681-fa7e-bc41-9173-6066a11f183e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]K", "[", "K_", "]"}], " ", ":=", " ", 
   RowBox[{"estacionarioEnBanda", "[", 
    RowBox[{
     RowBox[{"matrizSectores", "[", "K", "]"}], ",", " ", "d", ",", " ", 
     "K"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Rho]Kfase", "[", "K_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", " ", "=", " ", 
       RowBox[{"posicionesBanda", "[", 
        RowBox[{"d", ",", " ", "K"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"estacionarioEnBanda", "[", 
      RowBox[{
       RowBox[{"\[ScriptCapitalL]fase", "[", 
        RowBox[{"[", 
         RowBox[{"p", ",", " ", "p"}], "]"}], "]"}], ",", " ", "d", ",", " ", 
       "K"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"\[Rho]K", "[", "K", "]"}], " ", "-", " ", 
      RowBox[{"\[Rho]Kfase", "[", "K", "]"}]}], "]"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"K", ",", " ", "0", ",", " ", 
     RowBox[{"d", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], "Input",
 CellLabel->
  "In[224]:=",ExpressionUUID->"8cd22c27-1e9c-0942-b5ab-858bdde283e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.`", ",", "0.`", ",", "0.`", ",", "0.`", ",", "0.`", ",", "0.`"}],
   "}"}]], "Output",
 CellChangeTimes->{4.003315363332649*^9, 4.003315808517914*^9},
 CellLabel->
  "Out[226]=",ExpressionUUID->"1c8494a5-a54c-8b4c-ad90-005711a838af"]
}, Open  ]],

Cell["\<\
Referencias: todos los sectores (K = d \[Minus] 1, sin corte en k) y el l\
\[IAcute]mite cu\[AAcute]ntico usual (\[Kappa]m \[RightArrow] \[Infinity], \
solo |0\:27e9 y |1\:27e9), con \[CapitalPi] = p0 \[Minus] p1.\
\>", "Text",ExpressionUUID->"fbc16601-8b03-c644-a2df-0e3f93d699c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ref", " ", "=", " ", 
   RowBox[{"\[Rho]K", "[", 
    RowBox[{"d", " ", "-", " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[CapitalPi]0", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"9", " ", 
       RowBox[{"\[Kappa]p", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"4", " ", 
       RowBox[{"\[CapitalDelta]", "^", "2"}]}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"27", " ", 
       RowBox[{"\[Kappa]p", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"12", " ", 
       RowBox[{"\[CapitalDelta]", "^", "2"}]}], " ", "+", " ", 
      RowBox[{"6", " ", 
       RowBox[{"\[ScriptCapitalE]", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"limiteUsual", " ", "=", " ", 
  RowBox[{"N", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "\[CapitalPi]0"}], ")"}], "/", "2"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "\[CapitalPi]0"}], ")"}], "/", "2"}], ",", 
     " ", 
     RowBox[{
      RowBox[{"-", "I"}], " ", "\[ScriptCapitalE]", " ", 
      RowBox[{"\[CapitalPi]0", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"3", " ", "\[Kappa]p"}], " ", "+", " ", 
         RowBox[{"2", " ", "I", " ", "\[CapitalDelta]"}]}], ")"}]}]}]}], 
    "}"}], "]"}]}]}], "Input",
 CellLabel->
  "In[227]:=",ExpressionUUID->"ddd59d07-3209-1841-8633-8c176336b355"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.6388888888888888`", ",", "0.3611111111111111`", ",", 
