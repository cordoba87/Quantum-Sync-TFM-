        RowBox[{"l", " ", "-", " ", "1"}]}], "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"km0", " ", "=", " ", "20."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parC", "[", 
    RowBox[{"del_", ",", " ", "e_", ",", " ", 
