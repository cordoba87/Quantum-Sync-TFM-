      " ", "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k2", " ", "=", " ", 
   RowBox[{"mapa", "[", 
    RowBox[{"g3", ",", " ", 
     RowBox[{"{", 
      RowBox[{
