Cell["\<\
Cada fila se estanca en el error del ancho y cada columna en el del largo: el \
error es el mayor de los dos. En el l\[IAcute]mite cu\[AAcute]ntico los dos \
se controlan con r. Por eso, con L = 3, K = 1 da lo mismo que el cuadrado N = \
3 (0,040 frente a 0,041): las esquinas \[Rho]\:2082\:2080 y \
\[Rho]\:2080\:2082 no aportan nada. Contando elementos, la banda no ahorra \
mucho en este l\[IAcute]mite (figura 1c). La ventaja est\[AAcute] en otra \
cosa: si cada diagonal se resuelve entera, como funci\[OAcute]n (la EDO de \
B_k en z), el coste son los sectores, y K = 1 ya mejora a Fock con N = 3.\
\>", "Text",ExpressionUUID->"61dcb2d0-a0e0-b045-a2fa-be553b07d2e1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.6 Escalado con r y con \[ScriptCapitalE]", "Subsection",ExpressionUUID->"cb99ca38-8eb6-3344-8e79-56b1824a8617"],

Cell["\<\
Pendientes log-log. Con r: \[ScriptCapitalE] = \[Kappa]\:208a y r = 0,01, \
0,03, 0,1. Con \[ScriptCapitalE]: r = 0,05 y \[ScriptCapitalE] = 0,2, 0,4, \
0,8 \[Kappa]\:208a.\
\>", "Text",ExpressionUUID->"3b90101e-39be-d04b-ae47-e4253e4fcbd5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"pendiente", "[", 
    RowBox[{"xs_", ",", " ", "ys_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", " ", 
     RowBox[{"Coefficient", "[", 
      RowBox[{
       RowBox[{"Fit", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Log", "[", "xs", "]"}], ",", " ", 
            RowBox[{"Log", "[", "ys", "]"}]}], "}"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "t"}], "}"}], ",", " ", "t"}], "]"}], ",", 
       " ", "t"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.01", ",", " ", "0.03", ",", " ", "0.1"}], "}"}]}], ";", " ", 
  RowBox[{"es", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0.2", ",", " ", "0.4", ",", " ", "0.8"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"porR", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"pendiente", "[", 
    RowBox[{"rs", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"{", 
         RowBox[{"1.", ",", " ", 
          RowBox[{"1", "/", "#"}], ",", " ", "0.", ",", " ", "1."}], "}"}], 
        "]"}], " ", "&"}], " ", "/@", " ", "rs"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"porE", "[", "f_", "]"}], " ", ":=", " ", 
   RowBox[{"pendiente", "[", 
    RowBox[{"es", ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"parC", "[", 
         RowBox[{"0.", ",", " ", "#"}], "]"}], "]"}], " ", "&"}], " ", "/@", 
      " ", "es"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"{", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<con r\>\"", ",", " ", 
       RowBox[{"porR", "[", 
        RowBox[{
         RowBox[{"cuadrado", "[", 
          RowBox[{"3", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porR", "[", 
        RowBox[{
         RowBox[{"cuadrado", "[", 
          RowBox[{"4", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porR", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"1", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porR", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"2", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porR", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"3", ",", " ", "#"}], "]"}], " ", "&"}], "]"}]}], "}"}], ",",
      "\n", "  ", 
     RowBox[{"{", 
      RowBox[{"\"\<con \[ScriptCapitalE]\>\"", ",", " ", 
       RowBox[{"porE", "[", 
        RowBox[{
         RowBox[{"cuadrado", "[", 
          RowBox[{"3", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porE", "[", 
        RowBox[{
         RowBox[{"cuadrado", "[", 
          RowBox[{"4", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porE", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"1", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porE", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"2", ",", " ", "#"}], "]"}], " ", "&"}], "]"}], ",", " ", 
       RowBox[{"porE", "[", 
        RowBox[{
         RowBox[{"banda", "[", 
          RowBox[{"3", ",", " ", "#"}], "]"}], " ", "&"}], "]"}]}], "}"}]}], 
    "}"}], ",", "\n", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<\>\"", ",", " ", "\"\<N = 3\>\"", ",", 
        " ", "\"\<N = 4\>\"", ",", " ", "\"\<K = 1\>\"", ",", 
        " ", "\"\<K = 2\>\"", ",", " ", "\"\<K = 3\>\""}], "}"}]}], "}"}]}]}],
   "]"}]}], "Input",
