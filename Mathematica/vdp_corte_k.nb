Cell["\<\
Figura 4: el n\[UAcute]cleo de fase en (\[CapitalDelta], \[ScriptCapitalE]) = \
(0, 2\[Kappa]\:208a). (a) |K(\[Theta],\[Theta]')| de la referencia; (b) y (c) \
|\[CapitalDelta]K| de los dos cortes (cada uno con su escala).\
\>", "Text",ExpressionUUID->"61339ff6-0a44-c74b-9565-39347d9f1c7f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"nucleoNum", "[", "r_", "]"}], "[", 
    RowBox[{"t_", ",", " ", "tp_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "r", "]"}]}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"d", " ", "-", " ", "1"}]}], "]"}], " ", "t"}], "]"}], " ", 
      ".", " ", "r", " ", ".", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"I", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{"d", " ", "-", " ", "1"}]}], "]"}], " ", "tp"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"par4", " ", "=", " ", 
   RowBox[{"parC", "[", 
    RowBox[{"0.", ",", " ", "2."}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ref4", " ", "=", " ", 
   RowBox[{"estRef", "[", "par4", "]"}]}], ";", " ", 
  RowBox[{"f3", " ", "=", " ", 
   RowBox[{"rellenar", "[", 
    RowBox[{
     RowBox[{"estCuadrado", "[", 
      RowBox[{"3", ",", " ", "par4"}], "]"}], ",", " ", "dRef"}], "]"}]}], ";",
   " ", 
  RowBox[{"f1", " ", "=", " ", 
   RowBox[{"estBanda", "[", 
    RowBox[{"dRef", ",", " ", "1", ",", " ", "par4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ang", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", 
     RowBox[{"2", " ", "Pi"}], ",", " ", 
     RowBox[{"2", " ", 
      RowBox[{"Pi", "/", "150"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rejilla", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{"nucleoNum", "[", "r", "]"}], "[", 
        RowBox[{"t", ",", " ", "tp"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"tp", ",", " ", "ang"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "ang"}], "}"}]}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"filas", ":", " ", 
     RowBox[{"\[Theta]", "'"}]}], ",", " ", 
    RowBox[{"columnas", ":", " ", "\[Theta]"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"gRef", " ", "=", " ", 
   RowBox[{"rejilla", "[", "ref4", "]"}]}], ";", " ", 
  RowBox[{"g3", " ", "=", " ", 
   RowBox[{"rejilla", "[", 
    RowBox[{"f3", " ", "-", " ", "ref4"}], "]"}]}], ";", " ", 
  RowBox[{"g1", " ", "=", " ", 
   RowBox[{"rejilla", "[", 
    RowBox[{"f1", " ", "-", " ", "ref4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"maxRef", ",", " ", "max3", ",", " ", "max1"}], "}"}], " ", "=", 
   " ", 
   RowBox[{"Max", " ", "/@", " ", 
    RowBox[{"{", 
     RowBox[{"gRef", ",", " ", "g3", ",", " ", "g1"}], "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tk", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
